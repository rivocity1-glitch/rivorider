{
  "expo": {
    "name": "Rivo.City Rider",
    "slug": "rivorider",
    "version": "1.0.0",
    "owner": "rivo.ved",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "rivorider",
    "userInterfaceStyle": "automatic",

    "ios": {
      "icon": "./assets/icon.png"
    },

    "android": {
      "package": "com.rivo.ved.rivorider",
      "adaptiveIcon": {
        "backgroundColor": "#0D0D0D",
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/notification-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "POST_NOTIFICATIONS",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },

    "web": {
      "output": "static",
      "favicon": "./assets/favicon.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D0D0D",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220
        }
      ],
      "expo-audio",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Rivo.City Rider to access your location."
        }
      ],
      "expo-web-browser",
      "expo-asset"
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "1ad85a8f-1cc8-4510-8b46-3d39521d2260"
      }
    }
  }
}